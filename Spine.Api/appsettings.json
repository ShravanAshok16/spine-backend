{
  "Jwt": {
    "Issuer": "Spine",
    "Audience": "SpineClient",
    "Key": "development-placeholder-key-not-for-production-at-least-32-chars",
    "ExpiresMinutes": 30
  },
    "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
